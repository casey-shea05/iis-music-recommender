# Copy to .env and fill in your own values. See docs/SETUP.md, Pathway 2.
# The app runs without this file (fake player, committed catalogue).

# Spotify app (developer.spotify.com/dashboard). Client ID only: login uses PKCE, so no secret.
SPOTIFY_CLIENT_ID=
# Must match a Redirect URI registered on the Spotify app exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Only needed for `npm run catalogue` (www.last.fm/api/account/create).
LASTFM_API_KEY=
